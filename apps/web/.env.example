# Copy to .env.local for local development.

# URL of the @pw/api service. In local dev, defaults to localhost:3001.
# In production, set this in the Cloudflare Pages dashboard to your Railway URL,
#   e.g. https://portfolio-wars-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: a separate internal URL used only by server components (Next.js SSR).
# Useful if you give Cloudflare a private hostname that's faster than the public one.
# API_URL=
