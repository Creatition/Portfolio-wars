    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.0.0-rc.466",
    "superjson": "2.2.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.5.3"
  }
}
