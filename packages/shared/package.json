{
  "name": "@pw/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, tRPC router, and mock data for Portfolio Wars apps.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
